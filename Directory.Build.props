<Project>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Daniel</Authors>
    <Company>MCUnderground</Company>
    <Product>MxUtilities.NET</Product>
    <Copyright>Copyright (c) 2024 Daniel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/MCUnderground/MxUtilities.NET</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/MCUnderground/MxUtilities.NET</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
